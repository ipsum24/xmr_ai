{
  "name": "@wusdt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "deploy": "tsx scripts/launch/deploy-autonomous.ts",
    "test:deployment": "node --import tsx --test --test-concurrency=1 scripts/launch/deployment.test.ts",
    "test:contracts": "node --import tsx --test --test-concurrency=1 scripts/launch/contracts.test.ts",
    "launch:preflight": "tsx scripts/launch/preflight.ts",
    "launch:deploy": "tsx scripts/launch/deploy-fleet.ts",
    "launch:verify": "tsx scripts/launch/verify-fleet.ts",
    "launch:gas": "tsx scripts/launch/gas-forward.ts",
    "launch:smoke": "tsx scripts/launch/smoke-cycle.ts",
    "vault:check": "tsx scripts/vault-conformance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.750.0",
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "solc": "^0.8.26",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
